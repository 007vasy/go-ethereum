:1,"depth":0,"isTest":false,"patch":[{"t":"@","s":"@@ -74,6 +74,27 @@"},{"t":" ","o":74,"n":74,"s":"// added automatically."},{"t":" ","o":75,"n":75,"s":"…"},{"t":" ","o":76,"n":76,"s":""},{"t":"+","n":77,"s":"// DropEnvVarsShadowedByArgs unsets environment variables for flags that are"},{"t":"+","n":78,"s":"// present on the command line."},{"t":"+","n":79,"s":"//"},{"t":"+","n":80,"s":"// urfave/cli validates an environment variable while applying the flag, before"},{"t":"+","n":81,"s":"// the command-line value can replace it. An unparsable value therefore aborts"},{"t":"+","n":82,"s":"// startup even when the flag is set explicitly (for example GETH_PORT=tcp://..."},{"t":"+","n":83,"s":"// together with --port). Command-line flags are defined to take precedence, so"},{"t":"+","n":84,"s":"// drop the shadowed variables before the app is run. Variables for flags that"},{"t":"+","n":85,"s":"// are not set on the command line are left alone."},{"t":"+","n":86,"s":"…"},{"t":"+","n":87,"s":""},{"t":"+","n":88,"s":"// flagsPresentInArgs returns the names of known flags that appear in args."},{"t":"+","n":89,"s":"// The program name in args[0] is ignored. A flag's value is not itself scanned,"},{"t":"+","n":90,"s":"// so a value that looks like another flag (for example --datadir --port) does"},{"t":"+","n":91,"s":"// not count as setting that flag. Scanning stops at \"--\"."},{"t":"+","n":92,"s":"…"},{"t":"+","n":93,"s":""},{"t":"+","n":94,"s":"// splitFlagArg reports the flag name in arg. attached is true when the value"},{"t":"+","n":95,"s":"// is in the same argument (--name=value). ok is false when arg is not a flag."},{"t":"+","n":96,"s":"…"},{"t":"+","n":97,"s":""},{"t":" ","o":77,"n":98,"s":"// CheckEnvVars iterates over all the environment variables and checks if any of"},{"t":" ","o":78,"n":99,"s":"// them look like a CLI flag but is not consumed. This can be used to detect old"},{"t":" ","o":79,"n":100,"s":"// or mistyped names."}],"patchTruncated":false,"added":21,"removed":0,"covered":null},{"id":"internal/flags/helpers.go::DropEnvVarsShadowedByArgs","label":"DropEnvVarsShadowedByArgs","type":"function","kind":"function","status":"added","file":"internal/flags/helpers.go","lang":"go","line":274,"depth":0,"isTest":false,"patch":[{"t":"@","s":"@@ -1,0 +274,25 @@"},{"t":"+","n":274,"s":"func DropEnvVarsShadowedByArgs(flags []cli.Flag, args []string) {"},{"t":"+","n":275,"s":"\tpresent := flagsPresentInArgs(flags, args)"},{"t":"+","n":276,"s":"\tif len(present) == 0 {"},{"t":"+","n":277,"s":"\t\treturn"},{"t":"+","n":278,"s":"\t}"},{"t":"+","n":279,"s":"\tfor _, flag := range flags {"},{"t":"+","n":280,"s":"\t\tdoc, ok := flag.(cli.DocGenerationFlag)"},{"t":"+","n":281,"s":"\t\tif !ok {"},{"t":"+","n":282,"s":"\t\t\tcontinue"},{"t":"+","n":283,"s":"\t\t}"},{"t":"+","n":284,"s":"\t\tshadowed := false"},{"t":"+","n":285,"s":"\t\tfor _, name := range flag.Names() {"},{"t":"+","n":286,"s":"\t\t\tif _, ok := present[name]; ok {"},{"t":"+","n":287,"s":"\t\t\t\tshadowed = true"},{"t":"+","n":288,"s":"\t\t\t\tbreak"},{"t":"+","n":289,"s":"\t\t\t}"},{"t":"+","n":290,"s":"\t\t}"},{"t":"+","n":291,"s":"\t\tif !shadowed {"},{"t":"+","n":292,"s":"\t\t\tcontinue"},{"t":"+","n":293,"s":"\t\t}"},{"t":"+","n":294,"s":"\t\tfor _, envvar := range doc.GetEnvVars() {"},{"t":"+","n":295,"s":"\t\t\tos.Unsetenv(envvar)"},{"t":"+","n":296,"s":"\t\t}"},{"t":"+","n":297,"s":"\t}"},{"t":"+","n":298,"s":"}"}],"patchTruncated":false,"added":25,"removed":0,"covered":true},{"id":"internal/flags/helpers.go::flagsPresentInArgs","label":"flagsPresentInArgs","type":"function","kind":"function","status":"added","file":"internal/flags/helpers.go","lang":"go","line":304,"depth":0,"isTest":false,"patch":[{"t":"@","s":"@@ -1,0 +304,34 @@"},{"t":"+","n":304,"s":"func flagsPresentInArgs(flags []cli.Flag, args []string) map[string]struct{} {"},{"t":"+","n":305,"s":"\ttakesValue := make(map[string]bool)"},{"t":"+","n":306,"s":"\tfor _, flag := range flags {"},{"t":"+","n":307,"s":"\t\tvalue := true"},{"t":"+","n":308,"s":"\t\tif doc, ok := flag.(cli.DocGenerationFlag); ok {"},{"t":"+","n":309,"s":"\t\t\tvalue = doc.TakesValue()"},{"t":"+","n":310,"s":"\t\t}"},{"t":"+","n":311,"s":"\t\tfor _, name := range flag.Names() {"},{"t":"+","n":312,"s":"\t\t\ttakesValue[name] = value"},{"t":"+","n":313,"s":"\t\t}"},{"t":"+","n":314,"s":"\t}"},{"t":"+","n":315,"s":"\tpresent := make(map[string]struct{})"},{"t":"+","n":316,"s":"\tfor i := 1; i < len(args); i++ {"},{"t":"+","n":317,"s":"\t\targ := args[i]"},{"t":"+","n":318,"s":"\t\tif arg == \"--\" {"},{"t":"+","n":319,"s":"\t\t\tbreak"},{"t":"+","n":320,"s":"\t\t}"},{"t":"+","n":321,"s":"\t\tname, attached, ok := splitFlagArg(arg)"},{"t":"+","n":322,"s":"\t\tif !ok {"},{"t":"+","n":323,"s":"\t\t\tcontinue"},{"t":"+","n":324,"s":"\t\t}"},{"t":"+","n":325,"s":"\t\ttakes, known := takesValue[name]"},{"t":"+","n":326,"s":"\t\tif !known {"},{"t":"+","n":327,"s":"\t\t\tcontinue"},{"t":"+","n":328,"s":"\t\t}"},{"t":"+","n":329,"s":"\t\tpresent[name] = struct{}{}"},{"t":"+","n":330,"s":"\t\t// Value-taking flags consume the next argument even when it looks like"},{"t":"+","n":331,"s":"\t\t// a flag, matching package flag. --datadir --port sets datadir, not port."},{"t":"+","n":332,"s":"\t\tif !attached && takes && i+1 < len(args) {"},{"t":"+","n":333,"s":"\t\t\ti++"},{"t":"+","n":334,"s":"\t\t}"},{"t":"+","n":335,"s":"\t}"},{"t":"+","n":336,"s":"\treturn present"},{"t":"+","n":337,"s":"}"}],"patchTruncated":false,"added":34,"removed":0,"covered":true},{"id":"internal/flags/helpers.go::splitFlagArg","label":"splitFlagArg","type":"function","kind":"function","status":"added","file":"internal/flags/helpers.go","lang":"go","line":341,"depth":0,"isTest":false,"patch":[{"t":"@","s":"@@ -1,0 +341,13 @@"},{"t":"+","n":341,"s":"func splitFlagArg(arg string) (name string, attached bool, ok bool) {"},{"t":"+","n":342,"s":"\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {"},{"t":"+","n":343,"s":"\t\tret